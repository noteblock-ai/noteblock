<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Quire (and its Electron helpers, via entitlementsInherit).
  allow-jit: V8 needs it; a custom entitlements file replaces electron-builder's default, which
  only had this key.
  disable-library-validation: page builds and backends run with Quire's own binary as Node
  (process.execPath with ELECTRON_RUN_AS_NODE=1, see app/main/tools.mjs), so they inherit these
  entitlements. They load native modules from npm (rolldown for Vite, esbuild, sharp, ...), which
  are signed by other teams or not at all. Without this key, library validation refuses them:
  "mapping process and mapped file (non-platform) have different Team IDs".
  The network keys only take effect under the App Sandbox (which Quire does not use) and are
  listed so a later sandboxed build keeps page backends and the local proxy working.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
