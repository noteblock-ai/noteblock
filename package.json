{
  "name": "quire",
  "version": "0.3.5",
  "private": true,
  "description": "Notes where every page is a little HTML app",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "main": "app/main/main.mjs",
  "bin": {
    "quire": "cli/quire.mjs",
    "noteblock": "cli/quire.mjs"
  },
  "scripts": {
    "dev": "pnpm build:vendor && node scripts/gen-icon.mjs && vite build && node scripts/dev-electron.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:mobile": "node scripts/build-mobile-host.mjs",
    "build": "pnpm build:vendor && node scripts/fetch-tools.mjs && vite build",
    "check": "node scripts/check.mjs",
    "dist": "pnpm build && node scripts/gen-icon.mjs && node scripts/write-version.mjs && electron-builder --mac --arm64 --dir -c.mac.notarize=false",
    "install-app": "node scripts/install-app.mjs",
    "setup-cli": "node scripts/setup-cli.mjs",
    "mcp": "node --disable-warning=ExperimentalWarning mcp/server.mjs",
    "web": "node --disable-warning=ExperimentalWarning app/web/server.mjs",
    "verify:seed": "node scripts/verify-seed.mjs",
    "fetch-tools": "node scripts/fetch-tools.mjs",
    "dist:win": "pnpm build:vendor && node scripts/fetch-tools.mjs --win && vite build && node scripts/gen-icon.mjs && node scripts/write-version.mjs && electron-builder --win --x64 --arm64 --publish never"
  },
  "build": {
    "appId": "org.harborapps.quire",
    "productName": "Noteblock",
    "protocols": [
      {
        "name": "Noteblock",
        "schemes": [
          "noteblock"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/main/**",
      "app/runtime/**",
      "app/renderer/dist/**",
      "core/**",
      "examples/**",
      "package.json",
      "!examples/**/node_modules/**",
      "!examples/**/data/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "x64ArchFiles": "Contents/Resources/{git/**,app/node_modules/pnpm/dist/*.node}",
      "notarize": true,
      "artifactName": "Noteblock-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/tools/git",
          "to": "git",
          "filter": [
            "darwin-arm64/**/*",
            "darwin-x64/**/*",
            "!**/.dugite-native"
          ]
        }
      ]
    },
    "asar": false,
    "dmg": {
      "artifactName": "Noteblock-${version}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 150
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 360
      },
      "writeUpdateInfo": false
    },
    "electronLanguages": [
      "en"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "build/tools/git/win32-${arch}",
          "to": "git/win32-${arch}",
          "filter": [
            "**/*",
            "!.dugite-native"
          ]
        }
      ],
      "artifactName": "Noteblock-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Noteblock-${version}-setup.${ext}",
      "shortcutName": "Noteblock",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-updater": "6.8.9",
    "marked": "^18.1.1",
    "node-html-parser": "^9.0.4",
    "pnpm": "10.34.6",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "dugite": "3.2.3",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "htm": "^3.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
